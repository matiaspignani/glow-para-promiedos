{
  "manifest_version": 3,
  "name": "Glow para Promiedos",
  "short_name": "Glow Promiedos",
  "version": "0.6.2",
  "description": "Mejoras no oficiales para Promiedos: tema oscuro, tus clubes en la barra, estadísticas, noticias y sin publicidad.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://news.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.promiedos.com.ar/*", "https://promiedos.com.ar/*"],
      "css": ["content.css"],
      "js": ["layout.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.promiedos.com.ar/*", "https://promiedos.com.ar/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
